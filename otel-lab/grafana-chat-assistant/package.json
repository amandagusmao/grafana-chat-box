{
  "name": "grafana-chat-assistant",
  "version": "1.0.0",
  "description": "Um assistente de chat para auxiliar na criação de dashboards no Grafana.",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "dev": "webpack --config webpack.config.js --mode development --watch",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:fix": "eslint --ext .ts,.tsx src --fix",
    "reset-grafana": "npm run build && docker-compose restart grafana",
    "reset-grafana-full": "npm run build && docker-compose down -v && docker-compose up -d --build",
    "status-grafana": "docker exec -it otel-lab-grafana-1 ls -l /var/lib/grafana/plugins"
  },
  "keywords": [
    "grafana",
    "plugin",
    "app"
  ],
  "author": "Amanda Gusmão",
  "license": "MIT",
  "devDependencies": {
    "@grafana/data": "latest",
    "@grafana/runtime": "latest",
    "@grafana/ui": "latest",
    "@testing-library/react": "^13.4.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^6.7.1",
    "eslint": "^8.25.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fork-ts-checker-webpack-plugin": "^7.2.13",
    "glob-all": "^3.2.1",
    "prettier": "^2.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.55.0",
    "sass-loader": "^13.1.0",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.1",
    "typescript": "^4.8.4",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}

{
  "type": "app",
  "name": "Grafana Chat Assistant",
  "id": "grafana-chat-assistant",
  "category": "plugin",
  "executable": "gpx_grafana-chat-assistant",
  "backend": true,
  "dependencies": {
    "grafanaVersion": "9.0.0",
    "plugins": []
  },
  "includes": [
    {
      "type": "page",
      "name": "Chat Assistant",
      "path": "/a/grafana-chat-assistant/chat",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Configuration",
      "path": "/a/grafana-chat-assistant/config",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "info": {
    "description": "Um assistente de chat com IA para auxiliar na criação de dashboards no Grafana. Utiliza OpenAI para entender suas necessidades e criar dashboards automaticamente.",
    "author": {
      "name": "Amanda Gusmão",
      "email": "amanda.gusmao@bradesco.com.br"
    },
    "keywords": ["chat", "assistant", "dashboard", "grafana", "ai", "openai"],
    "links": [
      {
        "name": "Website",
        "url": "https://example.com"
      },
      {
        "name": "License",
        "url": "https://github.com/grafana/grafana-starter-app-plugin/blob/master/LICENSE"
      }
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "2.0.0",
    "updated": "2024-01-01"
  }
}
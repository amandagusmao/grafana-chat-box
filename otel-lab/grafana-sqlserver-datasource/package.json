{
  "name": "grafana-sqlserver-datasource",
  "version": "1.0.0",
  "description": "SQL Server datasource plugin for Kafka schema with dynamic query builder",
  "scripts": {
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "webpack --config webpack.config.js --mode production",
    "build:backend": "mage -v buildAll",
    "build:backend:linux": "mage -v buildLinux",
    "build:backend:windows": "mage -v buildWindows",
    "build:backend:darwin": "mage -v buildDarwin",
    "dev": "webpack --config webpack.config.js --mode development --watch",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:fix": "eslint --ext .ts,.tsx src --fix",
    "test:backend": "go test ./pkg/...",
    "clean": "mage clean"
  },
  "devDependencies": {
    "@grafana/data": "latest",
    "@grafana/runtime": "latest",
    "@grafana/ui": "latest",
    "@emotion/css": "^11.11.2",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "eslint": "^8.25.0",
    "fork-ts-checker-webpack-plugin": "^7.2.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.55.0",
    "sass-loader": "^13.1.0",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.1",
    "typescript": "^4.8.4",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
